# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Distribution anc packaging
build/
dist/
*.egg-info/
*.egg
*.whl

# Virtual environments
venv/
.env/
.envrc
.venv/

# OS and editor junk
.DS_Store
.vscode/
.cursorignore
*.swp
*.swo

# Pytest / testing / coverage
htmlcov/
.coverage
.tox/
.pytest_cache/
.cache/
nosetests.xml
coverage.xml
*.log

# Misc
*.out
*.tmp

# Benchmark artifacts: synthetic datasets and the local results log
# (benchmark_log.tsv contains machine-specific paths, so it is generated
# per machine rather than tracked)
benchmarks/data/
benchmarks/benchmark_log.tsv

# Local sequencing-read datasets and matrices derived from them; real read
# data is far too large to track and test fixtures live under tests/ instead
*reads*.tsv
*reads*.fasta
*reads*.fastq
